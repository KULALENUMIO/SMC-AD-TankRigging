// Custom Function of "TankRig/Particle Unlit" (HDRP Unlit, transparent): texture x particle colour x tint.
// HDRP draws Unlit colour without the camera exposure, so the colours look as in the URP version.
// The graph is generated by SMC-AD/unity/tools/make_sm_graphs.py (do not edit the .shadergraph by hand).
#ifndef TANKRIG_PARTICLE_INCLUDED
#define TANKRIG_PARTICLE_INCLUDED

void TankRigParticle_float(float4 UV0, float4 VertexColor, out float3 Color, out float Alpha)
{
    float4 t = SAMPLE_TEXTURE2D(_BaseColorMap, sampler_BaseColorMap, UV0.xy * _BaseColorMap_ST.xy + _BaseColorMap_ST.zw);
    float4 c = t * VertexColor * _BaseColor;
    Color = c.rgb;
    Alpha = c.a;
}

#endif
